<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sumteum" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/noto_sans_kr_regular</item>
        <!-- Break Korean between phrases, not inside a word (API 33+). -->
        <item name="android:textViewStyle">@style/KoreanText</item>
    </style>

    <style name="KoreanText" parent="android:Widget.Material.TextView">
        <item name="android:lineBreakWordStyle">phrase</item>
    </style>
</resources>
