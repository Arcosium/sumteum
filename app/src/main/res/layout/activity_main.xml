<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_kr_bold"
                android:text="@string/app_name"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:textColor="@color/text2"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/demo"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="24dp"
                android:background="@color/surface"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="시연 주행"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_kr_bold"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="실내 CO₂" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ppm"
                        style="@style/Big" />

                    <TextView
                        style="@style/Unit"
                        android:text="ppm" />
                </LinearLayout>

                <com.arka.sumteum.BarGauge
                    android:id="@+id/gauge"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginEnd="40dp" />

                <TextView
                    android:id="@+id/air"
                    style="@style/Line"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <View style="@style/Rule" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="40dp">

                <TextView
                    style="@style/Label"
                    android:text="졸음 위험" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/risk"
                        style="@style/Big" />

                    <TextView
                        android:id="@+id/level"
                        style="@style/Unit"
                        android:fontFamily="@font/noto_sans_kr_bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/factors"
                    style="@style/Line"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/text2" />
            </LinearLayout>

            <View style="@style/Rule" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.95"
                android:orientation="vertical"
                android:paddingStart="40dp">

                <TextView
                    style="@style/Label"
                    android:text="다음 쉼터  ·  © OpenStreetMap" />

                <TextView
                    android:id="@+id/stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/noto_sans_kr_bold"
                    android:maxLines="2"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_kr_bold"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/waypoint"
                    style="@style/Line"
                    android:fontFamily="@font/noto_sans_kr_bold"
                    android:textColor="@color/accent" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ladder"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:orientation="horizontal">

            <TextView style="@style/Step" android:text="1  외기 환기" />
            <TextView style="@style/Step" android:layout_marginStart="8dp" android:text="2  온도·통풍·조명" />
            <TextView style="@style/Step" android:layout_marginStart="8dp" android:text="3  음성 확인" />
            <TextView style="@style/Step" android:layout_marginStart="8dp" android:text="4  쉼터 경유" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cabin"
                style="@style/Line"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textColor="@color/text2" />

            <TextView
                android:id="@+id/event"
                style="@style/Line"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ask"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="40dp"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/askText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans_kr_bold"
            android:lineSpacingMultiplier="1.1"
            android:textSize="34sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/yes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/accent"
                android:fontFamily="@font/noto_sans_kr_bold"
                android:gravity="center"
                android:text="경유지로 넣기"
                android:textColor="@color/bg"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/no"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@color/line"
                android:gravity="center"
                android:text="괜찮아요"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
